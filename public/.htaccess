# Jino shared hosting (Apache). Modules are optional: every block is guarded.

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType image/svg+xml .svg
AddType video/mp4 .mp4

DirectoryIndex index.html

# Force HTTPS: the PWA (service worker, install) only works over HTTPS.
# X-Forwarded-Proto guards against a redirect loop behind a TLS-terminating proxy.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # The service worker and the HTML entry points must always be revalidated.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS and promo videos/posters are not fingerprinted: revalidate (ETag -> 304).
  <FilesMatch "\.(css|js|mjs|jpg|mp4)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
