; dg/ftp-deployment config: PRODUCTION (Jino shared hosting, FTP). Copy to deployment.prod.ini (gitignored) and fill in.
; `local` is resolved relative to this file: only public/ is uploaded.
[anniversary-calendar]
remote = ftp://your-production-server.example/www/anniversary-calendar
user = your-ftp-username
password = your-ftp-password
passiveMode = yes
local = public
test = no

ignore = "
	.DS_Store
	Thumbs.db
	*.bak
"

allowDelete = yes
preprocess = no
deploymentFile = .deployment
