; Template for D:/dev/anniversary-calendar.deployment.prod.ini (one directory up, never in the repo).
;   one-time: copy this file there by hand and fill in user/password
;   make deploy-check -> dry run
;   make deploy-prod  -> real upload

[anniversary-calendar prod]
remote = ftp://your-account.myjino.ru/
user = your-ftp-user
password = your-ftp-password
passiveMode = yes

; resolved relative to the ini file (D:/dev): only public/ is uploaded
local = anniversary-calendar/public
test = no

ignore = "
	.DS_Store
	Thumbs.db
	*.bak
"

allowDelete = yes
preprocess = no
